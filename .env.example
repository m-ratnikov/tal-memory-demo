# Copy to .env and fill in. .env is read at startup by python-dotenv
# (think appsettings.json, except values land in environment variables).

OPENAI_API_KEY=sk-put-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Reconcile judge: the highest-stakes write-path call gets a stronger model
# (one joint call per source, offline). mini measurably missed contradictions.
RECONCILE_JUDGE_MODEL=gpt-4o

# LangSmith tracing (LLM observability). Because this demo uses LangChain +
# LangGraph, tracing is enabled purely by these env vars - NO app-code changes.
# Set TRACING=true to capture every extraction-graph node, LLM call, embedding
# call, and eval judge as a nested trace (inputs, outputs, tokens, latency).
# Leave it commented out to run with tracing off.
#
# DATA-RESIDENCY NOTE: LangSmith's default endpoint is hosted SaaS - traces
# (which here contain student psychological facts) leave your infrastructure.
# For FCA-regulated data, self-host (Langfuse/Phoenix) or use a self-hosted
# LangSmith endpoint via LANGSMITH_ENDPOINT before turning this on in anger.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-put-your-key-here
# LANGSMITH_PROJECT=tal-memory-demo
#
# ENDPOINT must match your account's REGION, or every trace upload fails with
# a bare 403 Forbidden (measured 2026-07-11 - the SDK gives no better hint).
# US = https://api.smith.langchain.com (default),
# EU = https://eu.api.smith.langchain.com,
# APAC = https://apac.api.smith.langchain.com. Self-hosted goes here too.
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# Two connection strings, two roles - the RLS isolation story depends on this split:
# owner (postgres) BYPASSES row-level security -> migrations only.
# tal_app is subject to RLS -> everything request-scoped.
DSN_OWNER=postgresql://postgres:postgres@localhost:5434/tal
DSN_APP=postgresql://tal_app:tal_app@localhost:5434/tal

# Optional shared-password gate for a PUBLIC deployment. When set, every page
# (except /health) asks for HTTP Basic auth - username is ignored, this password
# is the only secret. Leave UNSET locally to run with no gate.
# DEMO_PASSWORD=change-me
